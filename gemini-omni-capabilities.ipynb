      "source": [
        "# --- Client, config, helpers (with auto-retry for transient errors) ---\n",
        "import base64, re, time, mimetypes\n",
        "from google import genai\n",
        "from IPython.display import HTML, display\n",
        "\n",
        "client = genai.Client(api_key=os.environ[\"GEMINI_API_KEY\"])\n",
        "OMNI_MODEL = \"gemini-omni-flash-preview\"   # Gemini Omni Flash\n",
        "ASPECT = \"16:9\"\n",
        "\n",
        "def _video(interaction):\n",
        "    for step in reversed(interaction.steps or []):\n",
        "        if getattr(step, \"type\", None) == \"model_output\" and step.content:\n",
        "            for c in reversed(step.content):\n",
        "                if getattr(c, \"type\", None) == \"video\":\n",
        "                    return c\n",
        "    return None\n",
        "\n",
        "def generate_video(inp, duration=None, previous_interaction_id=None, tries=4):\n",
        "    \"\"\"inp: a text string, or a list of content parts (images/text/document).\n",
        "    Video is requested via extra_body; URI delivery requires store=True.\n",
        "    Retries transient errors,but never retries a safety block (that needs a prompt change).\"\"\"\n",
        "    rf = {\"type\": \"video\", \"aspect_ratio\": ASPECT, \"delivery\": \"uri\"}\n",
        "    if duration:\n",
        "        rf[\"duration\"] = duration\n",
        "    kw = dict(model=OMNI_MODEL, input=inp, background=False, store=True, stream=False,\n",
        "              extra_body={\"response_format\": rf})\n",
        "    if previous_interaction_id:\n",
        "        kw[\"previous_interaction_id\"] = previous_interaction_id\n",
        "    last = None\n",
        "    for i in range(tries):\n",
        "        try:\n",
        "            return client.interactions.create(**kw)\n",
        "        except Exception as e:\n",
        "            if \"safety\" in str(e).lower():\n",
        "                raise\n",
        "            last = e\n",
        "            print(f\"  transient error, retry {i+1}/{tries}: {str(e)[:70]}\")\n",
        "            time.sleep(5)\n",
        "    raise last\n",
        "\n",
        "def show_video(interaction, save_as=None, poll_timeout=300):\n",
        "    v = _video(interaction)\n",
        "    if v is None:\n",
        "        print(\"No video in response:\", interaction.status); return\n",
        "    if getattr(v, \"uri\", None):\n",
        "        fid = re.search(r\"files/([^/:?]+)\", v.uri).group(1)\n",
        "        name = f\"files/{fid}\"\n",
        "        deadline = time.time() + poll_timeout\n",
        "        while True:\n",
        "            f = client.files.get(name=name)\n",
        "            state = getattr(f.state, \"name\", str(f.state))\n",
        "            if state == \"ACTIVE\": break\n",
        "            if state == \"FAILED\" or time.time() > deadline:\n",
        "                print(\"file state:\", state); return\n",
        "            time.sleep(4)\n",
        "        data = client.files.download(file=name)\n",
        "    else:\n",
        "        data = base64.b64decode(v.data) if isinstance(v.data, str) else v.data\n",
        "    if save_as:\n",
        "        open(save_as, \"wb\").write(data)\n",
        "    b64 = base64.b64encode(data).decode()\n",
        "    display(HTML(f'<video controls loop playsinline style=\"max-width:640px;border-radius:10px\">'\n",
        "                 f'<source src=\"data:video/mp4;base64,{b64}\" type=\"video/mp4\"></video>'))\n",
        "\n",
        "def img_part(path):\n",
        "    mt = mimetypes.guess_type(path)[0] or \"image/png\"\n",
        "    return {\"type\": \"image\", \"data\": base64.b64encode(open(path, \"rb\").read()).decode(), \"mime_type\": mt}\n",
        "\n",
        "def show_image(path):\n",
        "    b64 = base64.b64encode(open(path, \"rb\").read()).decode()\n",
        "    display(HTML(f'<img src=\"data:image/png;base64,{b64}\" style=\"max-width:360px;border-radius:8px\"/>'))\n",
        "\n",
        "print(\"Config is Ready\\n\")\n",
        "print(\"Omni model name:\", OMNI_MODEL)"
      ]
    },
