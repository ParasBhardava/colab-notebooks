      "source": [
        "# --- API key: Colab secret, local .env, or exported env var ---\n",
        "import os\n",
        "try:\n",
        "    from google.colab import userdata\n",
        "    os.environ[\"GEMINI_API_KEY\"] = userdata.get(\"GEMINI_API_KEY\")\n",
        "except Exception:\n",
        "    pass\n",
        "if not os.environ.get(\"GEMINI_API_KEY\"):\n",
        "    from pathlib import Path\n",
        "    p = Path(\".env\")\n",
        "    if p.exists():\n",
        "        for line in p.read_text().splitlines():\n",
        "            line = line.strip()\n",
        "            if line and not line.startswith(\"#\") and \"=\" in line:\n",
        "                k, v = line.split(\"=\", 1)\n",
        "                os.environ.setdefault(k.strip(), v.strip())\n",
        "assert os.environ.get(\"GEMINI_API_KEY\"), \"Set GEMINI_API_KEY (Colab secret, .env, or env var)\"\n",
        "print(\"API key loaded successfully\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "2168fe6c",
      "metadata": {
        "id": "2168fe6c",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "08a6b48d-7b74-4fb4-9f14-db94ce56b4d7"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Config is Ready\n",
            "\n",
            "Omni model name: gemini-omni-flash-preview\n"
